# Anthropic API key for Claude models (brand + supplier agents, parser).
ANTHROPIC_API_KEY=

# Postgres connection (Supabase local default).
# Run `supabase start` to provision; URL is printed in the output.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Inngest (dev mode auto-discovers via -u).
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# Frontend points at the API here.
VITE_API_BASE_URL=http://localhost:3000

# Voyage AI for catalog embeddings (SKU matching). Optional in early stages.
VOYAGE_API_KEY=

# Langfuse (optional observability).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
