{
  "name": "@app/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file=../../.env src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "bun --env-file=../../.env x drizzle-kit push",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio",
    "test": "bun --env-file=../../.env test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@app/shared": "workspace:*",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "inngest": "^3.54.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
