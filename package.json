{
  "name": "ai-brand-sourcing",
  "private": true,
  "version": "0.0.0",
  "description": "AI-driven supplier quotation parsing, multi-agent negotiation, and purchase order workflow.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:api": "bun --filter @app/api dev",
    "dev:web": "bun --filter @app/web dev",
    "dev:inngest": "bunx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "bun --filter @app/api db:push",
    "db:studio": "bun --filter @app/api db:studio",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "format": "bunx prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "bun --filter '*' test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.10"
}
